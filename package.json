{
  "name": "dsh-img-designer",
  "version": "0.1.0",
  "description": "DSH 生图 skill 插件：接需求 → 找参考 → 构图 → 生成/改图 → 按摄影工艺验收 → 定点修复。含模板库与根方法论。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check index.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "image-generation",
    "skill",
    "photography",
    "prompt-engineering"
  ],
  "author": "wlxms",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wlxms/dsh-img-designer.git"
  },
  "homepage": "https://github.com/wlxms/dsh-img-designer#readme",
  "bugs": {
    "url": "https://github.com/wlxms/dsh-img-designer/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-skill": ">=0.1.0"
  }
}
